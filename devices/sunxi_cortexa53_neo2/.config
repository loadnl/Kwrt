CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y

# 只编译 FriendlyARM NanoPi NEO2 (Allwinner H5, aarch64, 512MB/1GB), 不编该 target 下的全部设备
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-neo2=y

# 根文件系统: ext4 (SD 卡上可读写、可用 resize2fs 扩容, 方便装 Open-Box 与数据)
# NEO2 的 sdcard 镜像只有 boot + rootfs 两个分区, 选 squashfs 就没有可写的 overlay
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=n

# rootfs 分区大小 (MB)。Open-Box 安装包约 50MB, 运行后连同 GeoSite/GeoIP 与数据要 256MB 以上
CONFIG_TARGET_ROOTFS_PARTSIZE=1004

# Open-Box 运行依赖 (安装脚本会按功能检查这几项, 这里直接编进镜像, 免得到设备上 opkg 装)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y

# 透明代理常见缺件, 顺手补齐
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_curl=y

# SD 卡 / U 盘: 扩容分区、挂载外置存储
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
# e2fsprogs / partx-utils / uboot-envtools 已由 target/linux/sunxi/Makefile 默认带上
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# NEO2 只有一个原生千兆口, 想再挂一个网口就用 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
