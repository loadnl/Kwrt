CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y

CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y

# 只编译 Redmi AX5 JDCloud 一个设备, 不编译该 target 下的全部设备
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y

# 互联网插件: Open-Box (透明代理/科学上网, 自带 sing-box 内核与面板)
CONFIG_PACKAGE_luci-app-open-box=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ca-bundle=y
